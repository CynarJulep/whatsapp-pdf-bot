# Copy to .env and fill in. Never commit .env.
#
# Supabase → Project Settings → API
# The anon key is visible in the browser. The service role key stays on the server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vite exposes only VITE_* variables to the frontend. Use the anon key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# WhatsApp session id for this process (pai, licencias, ...)
SESSION_ID=pai

# Optional shared secret for POST /send-text. Empty disables the check (local only).
BOT_API_KEY=

# SAC portal (server or local worker only — never in frontend code)
SAC_FEATURE_ENABLED=false
SAC_PROCESS_JOBS=false
SAC_USER=
SAC_PASSWORD=
SAC_AUTOMATION_TOKEN=

# SMTP (optional claim email)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public site used by ops scripts and the local dashboard. Not a secret.
PUBLIC_SITE_URL=https://your-site.example

# Optional: scripts/local-stack/setup.ps1 can import env vars from Render.
RENDER_API_KEY=
RENDER_SERVICE_ID=

# Optional catalog seed (node seed_subtypes.js)
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_GID=0

# Tunnel registry object published for the Netlify proxy
BACKEND_REGISTRY_BUCKET=runtime
BACKEND_REGISTRY_OBJECT=backend-endpoints.json
